# Operator-owned file beside the broker database; mode 0600, no symlinks.
# Stage with execution disabled; fill reviewed absolute paths and real hashes.
version = 1
enabled = false
automatic = false
repositories = ["/absolute/path/to/reviewed/repository"]
timeout_seconds = 600

# Full immutable SHA of the operator-reviewed baseline; never an agent's review base/ref.
[policy_bases]
"/absolute/path/to/reviewed/repository" = "REPLACE_WITH_REVIEWED_FULL_COMMIT_SHA"

[mounts.python]
path = "/absolute/path/to/pinned/python"
tree_sha256 = "REPLACE_WITH_REVIEWED_TREE_SHA256"

[mounts.site]
path = "/absolute/path/to/pinned/site"
tree_sha256 = "REPLACE_WITH_REVIEWED_TREE_SHA256"

[tools.python]
path = "/absolute/path/to/pinned/python/bin/python3.13"
sha256 = "REPLACE_WITH_REVIEWED_EXECUTABLE_SHA256"
