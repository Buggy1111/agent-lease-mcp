[Unit]
Description=agent-lease wake bridge for an interactive Codex session
After=agent-lease-broker.service
Wants=agent-lease-broker.service

[Service]
EnvironmentFile=-%h/.config/agent-lease/environment
# Set AGENT_LEASE_CODEX_THREAD to the exact name assigned with Codex /rename.
Environment=AGENT_NAME=codex-wake
# Jen přes broker, i když se spustí dřív, než broker naváže socket (single writer).
Environment=AGENT_LEASE_REQUIRE_BROKER=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/agent-lease-codex-wake
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
