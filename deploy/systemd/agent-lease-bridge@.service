# Instance = jméno agenta: systemctl --user enable --now agent-lease-bridge@codex
[Unit]
Description=agent-lease bridge pro %i
After=agent-lease-broker.service
Wants=agent-lease-broker.service

[Service]
Environment=AGENT_NAME=%i-bridge
# Jen přes broker, i když se spustí dřív, než broker naváže socket (single writer).
Environment=AGENT_LEASE_REQUIRE_BROKER=1
# User systemd does not inherit the interactive shell PATH. Both uv-installed
# agent-lease entry points and the Codex launcher live in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/agent-lease/environment
# Pro OpenRouter: EnvironmentFile=%h/.config/agent-lease/openrouter.env (OPENROUTER_API_KEY=…, chmod 600)
ExecStart=%h/.local/bin/agent-lease-bridge --agent %i
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
